# MindMate AI — Environment Variables
# Copy this file to .env and fill in your values.

# ── Groq API (FREE — recommended for best AI quality, ~1s responses) ──────────
# Get your free API key at: https://console.groq.com  (no credit card needed)
# Supported models: llama-3.3-70b-versatile | llama-3.1-8b-instant | mixtral-8x7b-32768 | gemma2-9b-it
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (optional local fallback — only if you have ollama installed) ───────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3            # Options: llama3, mistral, gemma, deepseek-r1, qwen2

# ── Hugging Face emotion & sentiment models (downloaded automatically) ─────────
EMOTION_MODEL_ID=j-hartmann/emotion-english-distilroberta-base
SENTIMENT_MODEL_ID=cardiffnlp/twitter-roberta-base-sentiment-latest
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# ── API server ─────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Conversation memory ────────────────────────────────────────────────────────
MAX_HISTORY_TURNS=20
